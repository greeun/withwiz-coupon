{
  "packageManager": "pnpm@11.10.0",
  "name": "@withwiz/coupon",
  "version": "0.1.0",
  "description": "Multi-tenant, concurrency-safe coupon domain core for Prisma + Node.js applications",
  "license": "MIT",
  "author": "withwiz",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeun/withwiz-coupon.git"
  },
  "homepage": "https://github.com/greeun/withwiz-coupon#readme",
  "bugs": {
    "url": "https://github.com/greeun/withwiz-coupon/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "coupon",
    "discount",
    "promotion",
    "campaign",
    "prisma",
    "multi-tenant",
    "concurrency"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "prisma/fragment.prisma",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:concurrency:x3": "node scripts/check-concurrency-x3.mjs",
    "check:isolation": "node scripts/check-isolation.mjs",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push --schema=prisma/schema.prisma --skip-generate --accept-data-loss",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "zod": "^3.23.0",
    "nanoid": "^5.0.0",
    "@paralleldrive/cuid2": "^2.2.2"
  },
  "peerDependencies": {
    "@prisma/client": ">=5.0.0 <8.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@prisma/client": "^6.0.0",
    "@types/node": "^20.12.0",
    "@vitest/coverage-v8": "^1.6.0",
    "prisma": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
